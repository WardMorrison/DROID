{
  "name": "droid",
  "version": "1.0.0",
  "description": "Minimalist AI-powered utility bar for Windows",
  "main": "src/main.js",
  "scripts": {
    "setup": "node setup.js",
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:win": "electron-builder --windows --x64",
    "build:linux": "electron-builder --linux --x64",
    "pack": "electron-builder --dir"
  },
  "keywords": ["electron", "ai", "utility", "automation"],
  "author": "Your Name",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "groq-sdk": "^0.4.0"
  },
  "build": {
    "appId": "com.yourname.droid",
    "productName": "DROID",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": {
        "target": "nsis",
        "arch": ["x64"]
      },
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "linux": {
      "target": {
        "target": "AppImage",
        "arch": ["x64"]
      },
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}